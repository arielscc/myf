{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "API_HOST=http://localhost:3002 next -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write '{*.js,{pages,components,sections}/**/*.{js}}'",
    "prepare-hooks": "husky install"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@chakra-ui/theme-tools": "^2.2.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/euphoria-script": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "framer-motion": "^12.38.0",
    "isomorphic-unfetch": "^3.1.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-scroll": "^1.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{html,ts,tsx,js,jsx,css,scss}": [
      "pnpm eslint --cache --fix",
      "prettier --write",
      "git add"
    ]
  }
}
